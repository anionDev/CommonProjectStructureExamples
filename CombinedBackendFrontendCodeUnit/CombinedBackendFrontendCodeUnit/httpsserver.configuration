server {
    listen                  443 ssl;
    server_name             _;
    location /api/ {
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    Host $http_host;
        proxy_redirect      off;
        set $api            $apiaddress;
        proxy_pass          https://$api;
    }
    location / {
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    Host $http_host;
        proxy_redirect      off;
        set $website        $websiteaddress;
        proxy_pass          https://$website;
    }
}
