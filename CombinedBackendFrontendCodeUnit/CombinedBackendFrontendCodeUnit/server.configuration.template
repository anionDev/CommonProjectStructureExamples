server {
    listen                  __.port.__;
    server_name             _;
    location /api/ {
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    Host $http_host;
        proxy_redirect      off;
        set $apiaddress     __.apiaddress.__;
        proxy_pass          __.protocol.__://$apiaddress;
    }
    location / {
        proxy_set_header    X-Real-IP $remote_addr;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    Host $http_host;
        proxy_redirect      off;
        set $websiteaddress __.websiteaddress.__;
        proxy_pass          __.protocol.__://$websiteaddress;
    }
}
