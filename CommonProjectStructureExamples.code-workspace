{
	"folders": [
		{
			"path": ".",
			"name": "Entire project"
		},
		{
			"path": "./AngularCodeUnit",
			"name": "AngularCodeUnit"
		},
		{
			"path": "./ContainerCodeUnit",
			"name": "ContainerCodeUnit"
		},
		{
			"path": "./DotNetConsoleCodeUnit",
			"name": "DotNetConsoleCodeUnit"
		},
		{
			"path": "./DotNetLibraryCodeUnit",
			"name": "DotNetLibraryCodeUnit"
		},
		{
			"path": "./DotNetWebAPICodeUnit",
			"name": "DotNetWebAPICodeUnit"
		},
		{
			"path": "./FlutterCodeUnit",
			"name": "FlutterCodeUnit"
		},
		{
			"path": "./JavaCodeUnit",
			"name": "JavaCodeUnit"
		},
		{
			"path": "./KotlinCodeUnit",
			"name": "KotlinCodeUnit"
		},
		{
			"path": "./PythonLibraryCodeUnit",
			"name": "PythonLibraryCodeUnit"
		},
		{
			"path": "./ReactCodeUnit",
			"name": "ReactCodeUnit"
		},
		{
			"path": "./SpringCodeUnit",
			"name": "SpringCodeUnit"
		},
		{
			"path": "./VueJSCodeUnit",
			"name": "VueJSCodeUnit"
		},
	],
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Build all codeunits",
				"command": "SCBuildCodeunits",
				"args": [
					"--buildenvironment",
					"Development"
				],
				"type": "shell",
				"options": {
					"cwd": "${workspaceFolder}",
				},
			}
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug current file",
				"type": "python",
				"request": "launch",
				"program": "${file}",
				"console": "integratedTerminal"
			}
		]
	},
	"settings": {
		"spellright.documentTypes": [
			"markdown",
			"plaintext",
		],
		"spellright.language": [
			"en",
		],
	}
}