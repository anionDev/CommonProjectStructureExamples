{
	"folders": [
		{
			"path": ".",
			"name": "Entire project"
		},
		{
			"path": "./AngularCodeUnit",
			"name": "AngularCodeUnit"
		},
		{
			"path": "./ContainerCodeUnit",
			"name": "ContainerCodeUnit"
		},
		{
			"path": "./DotNetConsoleCodeUnit",
			"name": "DotNetConsoleCodeUnit"
		},
		{
			"path": "./DotNetLibraryCodeUnit",
			"name": "DotNetLibraryCodeUnit"
		},
		{
			"path": "./DotNetWebAPICodeUnit",
			"name": "DotNetWebAPICodeUnit"
		},
		{
			"path": "./PythonCodeUnit",
			"name": "PythonPackageCodeUnit"
		}
	],
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Build all codeunits",
				"command": "SCBuildCodeunits",
				"args": [
					"--buildenvironment",
					"Development"
				],
				"type": "shell",
				"options": {
					"cwd": "${workspaceFolder}",
				},
			},
			{
				"label": "ContainerCodeUnit: Run example",
				"command": "python ContainerCodeUnit/Other/Reference/ReferenceContent/Examples/MinimalDockerComposeFile/RunExample.py",
				"args": [],
				"type": "shell",
				"options": {
					"cwd": "${workspaceFolder}",
				},
			}
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Debug current file",
				"type": "python",
				"request": "launch",
				"program": "${file}",
				"console": "integratedTerminal"
			}
		]
	},
	"settings": {
		"files.exclude": {
			".coverage": true,
			"TestResults": true,
			".vs": true,
		},
		"spellright.language": [
			"en",
		],
		"spellright.documentTypes": [
			"markdown",
			"plaintext",
		],
	}
}