{
  "folders": [
    {
      "path": ".",
      "name": "Entire project"
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Base: Build all codeunits",
        "command": "scbuildcodeunits",
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "aliases": [
          "bb"
        ],
        "allowcustomarguments": true
      },
      {
        "label": "LocalTestService: MariaDB start",
        "command": "python Start.py",
        "args": [],
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}/Other/Resources/LocalTestServices/MariaDBDatabase"
        },
        "aliases": [
          "ldmu"
        ],
        "allowcustomarguments": true
      },
      {
        "label": "LocalTestService: MariaDB stop",
        "command": "python Stop.py",
        "args": [],
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}/Other/Resources/LocalTestServices/MariaDBDatabase"
        },
        "aliases": [
          "ldmd"
        ],
        "allowcustomarguments": true
      },
      {
        "label": "LocalTestService: PostgreSQL start",
        "command": "python Start.py",
        "args": [],
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}/Other/Resources/LocalTestServices/PostgreSQLDatabase"
        },
        "aliases": [
          "ldpu"
        ],
        "allowcustomarguments": true
      },
      {
        "label": "LocalTestService: PostgreSQL stop",
        "command": "python Stop.py",
        "args": [],
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}/Other/Resources/LocalTestServices/PostgreSQLDatabase"
        },
        "aliases": [
          "ldpd"
        ],
        "allowcustomarguments": true
      },
      {
        "label": "Update: Visual-regression-baselines",
        "command": "python UpdateVisualRegressionBaselines.py",
        "args": [],
        "type": "shell",
        "options": {
          "cwd": "${workspaceFolder}/Other/Scripts"
        },
        "aliases": [
          "uvrb"
        ],
        "allowcustomarguments": true
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Debug current file",
        "type": "python",
        "request": "launch",
        "program": "${file}",
        "console": "integratedTerminal"
      }
    ]
  },
  "settings": {
    "terminal.integrated.cwd": "${workspaceFolder}",
    "window.title": "${dirty} ${rootName}",
    "files.exclude": {
      ".coverage": true,
      "TestResults": true,
      ".vs": true
    },
    "spellright.language": [
      "en"
    ],
    "spellright.documentTypes": [
      "markdown",
      "plaintext"
    ]
  }
}
