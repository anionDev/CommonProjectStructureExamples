{
  "name": "angular-code-unit",
  "version": "1.2.0",
  "scripts": {
    "build": "npm run build-QualityCheck",
    "build-Development": "ng build --configuration Development",
    "build-QualityCheck": "ng build --configuration QualityCheck",
    "build-Productive": "ng build --configuration Productive",
    "test": "npm run test-QualityCheck",
    "test-Development": "ng test --configuration Development --browsers ChromeHeadless --code-coverage --watch false",
    "test-QualityCheck": "ng test --configuration QualityCheck --browsers ChromeHeadless --code-coverage --watch false",
    "test-Productive": "ng test --configuration Productive --browsers ChromeHeadless --code-coverage --watch false",
    "generate-api-client": "openapi --input ./Other/Resources/DependentCodeUnits/DotNetWebAPICodeUnit/APISpecification/DotNetWebAPICodeUnit.latest.api.json --output ./src/app/generated/dot-net-web-api-code-unit --client angular",
    "lint": "ng lint",
    "start": "ng serve --configuration Development --proxy-config DevelopmentProxy.config.json"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/material": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/router": "22.1.1",
    "@aniondev/ngx-darkmode-toggle-button": "2.0.2",
    "@fontsource/material-icons": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "zone.js": "0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@playwright/test": "1.62.1",
    "@types/jasmine": "5.1.7",
    "angular-eslint": "22.1.0",
    "eslint": "9.21.0",
    "jasmine-core": "5.6.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.15.0"
  }
}