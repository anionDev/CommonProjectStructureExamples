{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "AngularCodeUnit": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": "en",
        "locales": {
          "ar": "Other/Resources/Translations/messages.ar.xlf",
          "de": "Other/Resources/Translations/messages.de.xlf",
          "de-AT": "Other/Resources/Translations/messages.de-AT.xlf",
          "de-CH": "Other/Resources/Translations/messages.de-CH.xlf",
          "el": "Other/Resources/Translations/messages.el.xlf",
          "en-GB": "Other/Resources/Translations/messages.en-GB.xlf",
          "es": "Other/Resources/Translations/messages.es.xlf",
          "es-MX": "Other/Resources/Translations/messages.es-MX.xlf",
          "fr": "Other/Resources/Translations/messages.fr.xlf",
          "pt": "Other/Resources/Translations/messages.pt.xlf",
          "ru": "Other/Resources/Translations/messages.ru.xlf",
          "zh": "Other/Resources/Translations/messages.zh.xlf"
        }
      },
      "architect": {
        "build": {
          "defaultConfiguration": "Development",
          "builder": "@angular/build:application",
          "configurations": {
            "Productive": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "QualityCheck": {
              "optimization": false,
              "sourceMap": true,
              "outputHashing": "all"
            },
            "Development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "options": {
            "outputPath": "Other/Artifacts/BuildResult_WebApplication",
            "index": "src/index.html",
            "polyfills": [
              "zone.js",
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [
              "node_modules/@fontsource/roboto/300.css",
              "node_modules/@fontsource/roboto/400.css",
              "node_modules/@fontsource/roboto/500.css",
              "node_modules/@fontsource/material-icons/index.css",
              "src/styles.scss"
            ],
            "scripts": [],
            "browser": "src/main.ts"
          }
        },
        "serve": {
          "defaultConfiguration": "Development",
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "Productive": {
              "buildTarget": "AngularCodeUnit:build:Productive"
            },
            "QualityCheck": {
              "buildTarget": "AngularCodeUnit:build:QualityCheck"
            },
            "Development": {
              "buildTarget": "AngularCodeUnit:build:Development"
            }
          },
          "options": {
            "port": 4200
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "AngularCodeUnit:build",
            "outputPath": "Other/Resources/Translations",
            "format": "xlf2",
            "outFile": "messages.xlf"
          }
        },
        "test": {
          "defaultConfiguration": "Development",
          "builder": "@angular/build:unit-test",
          "configurations": {
            "Productive": {
              "buildTarget": "AngularCodeUnit:build:Productive"
            },
            "QualityCheck": {
              "buildTarget": "AngularCodeUnit:build:QualityCheck"
            },
            "Development": {
              "buildTarget": "AngularCodeUnit:build:Development"
            }
          },
          "options": {
            "runner": "vitest",
            "runnerConfig": "vitest-base.config.ts",
            "tsConfig": "tsconfig.spec.json",
            "coverage": true,
            "coverageReporters": [
              "cobertura",
              "text-summary"
            ]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "schematicCollections": [
      "@angular-eslint/schematics"
    ],
    "analytics": false
  }
}